# 复制成 .env 再填写。填好的 .env 不要提交。
# 下面先留空，做到对应步骤时再填。

# 第 1 步：Cloudflare R2（私有桶）
# Endpoint 一般是 https://你的账号ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# 第 2 步：Supabase（只在服务端用，不要放到网页里）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 第 3 步：下载接口的共享密钥
# 调用时放在请求头：Authorization: Bearer 后面
DOWNLOAD_SECRET=

# 第 7 步：把网站部署到 Cloudflare Workers。只在跑部署的机器上填写，不要提交。
# 到 https://dash.cloudflare.com/profile/api-tokens ，用模板「编辑 Cloudflare Workers」。
# 这是账户 API 令牌，不是 R2 的对象存储令牌。
CLOUDFLARE_API_TOKEN=
# 可选。网站要绑的域名，必须已经在这个 Cloudflare 账号里。例如 templates.example.com
WEB_DOMAIN=

# 第 6 步：看预览图自动填主题、色调、标签。不填也能入库。
# 接口要兼容 OpenAI 的 chat/completions，并且能看图片。
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
