{
  "name": "ppt-template-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "ci": "find scripts -name '*.ts' -print0 | xargs -0 -r -n1 node --disable-warning=ExperimentalWarning --experimental-strip-types --check",
    "r2:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types --env-file-if-exists=.env scripts/r2-check.ts",
    "supabase:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types --env-file-if-exists=.env scripts/supabase-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0"
  }
}
